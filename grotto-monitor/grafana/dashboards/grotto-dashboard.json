      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('1 hour', time) AS time,\n  gs.name AS metric,\n  avg(md.value) AS value\nFROM monitoring_data md\nJOIN sensors s ON s.id = md.sensor_id\nJOIN grotto_sites gs ON gs.id = md.site_id\nWHERE s.sensor_type = '温度'\n  AND time >= now() - INTERVAL '24 hours'\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "where": []
        }
      ],
      "title": "各石窟群温度趋势 (24小时)",
      "type": "timeseries"
    },
