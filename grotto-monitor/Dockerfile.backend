FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

COPY backend/go.mod ./
COPY backend/go.sum ./ 2>/dev/null || true
RUN go mod download || true

COPY backend/ ./backend/
WORKDIR /app/backend

RUN CGO_ENABLED=0 GOOS=linux go build -o /grotto-backend .

FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Shanghai

WORKDIR /app

COPY --from=builder /grotto-backend /app/grotto-backend
COPY backend/config/ /app/config/
COPY frontend/ /app/frontend/

EXPOSE 8080

CMD ["/app/grotto-backend"]
