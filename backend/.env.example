# 服务配置
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30

# 数据库配置 (TimescaleDB)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=grotto_monitor
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# 告警阈值配置
ALERT_CRACK_THRESHOLD=0.5
ALERT_HARDNESS_DROP_PERCENT=20.0
ALERT_ENABLE_WEBSOCKET=true
