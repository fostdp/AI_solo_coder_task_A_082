          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n  gs.name AS \"石窟群名称\",\n  COUNT(DISTINCT s.id) AS \"传感器数量\",\n  COUNT(md.*) AS \"数据记录数\",\n  MAX(md.time) AS \"最新数据时间\"\nFROM grotto_sites gs\nLEFT JOIN sensors s ON s.site_id = gs.id\nLEFT JOIN monitoring_data md ON md.site_id = gs.id\nGROUP BY gs.id, gs.name\nORDER BY gs.id",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "where": []
        }
