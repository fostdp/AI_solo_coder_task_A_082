FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

COPY backend/simulator/go.mod ./backend/simulator/
WORKDIR /app/backend/simulator
RUN go mod download || true

COPY backend/simulator/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /grotto-simulator .

FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Shanghai

WORKDIR /app

COPY --from=builder /grotto-simulator /app/grotto-simulator

EXPOSE 8081

CMD ["/app/grotto-simulator"]
