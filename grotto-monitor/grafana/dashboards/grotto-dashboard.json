      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.id AS \"告警ID\",\n  gs.name AS \"石窟群\",\n  s.sensor_code AS \"传感器\",\n  a.alert_type AS \"告警类型\",\n  a.severity AS \"严重程度\",\n  a.value AS \"当前值\",\n  a.threshold AS \"阈值\",\n  a.triggered_at AS \"触发时间\",\n  a.acknowledged AS \"已确认\"\nFROM alerts a\nJOIN grotto_sites gs ON gs.id = a.site_id\nJOIN sensors s ON s.id = a.sensor_id\nORDER BY a.triggered_at DESC\nLIMIT 20",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "where": []
        }
      ],
